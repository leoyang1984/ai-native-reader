{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Native Reader",
  "version": "0.1.5",
  "identifier": "com.leoyang.ainativereader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Native Reader",
        "width": 1200,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' blob:; img-src 'self' blob: data:; font-src 'self' blob: data:; frame-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/reader-v2.icns",
      "icons/reader-v2.png"
    ],
    "resources": [
      "../LICENSE",
      "../COPYRIGHT",
      "../LICENSES/",
      "../release-notices/"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ainativereader"
        ]
      }
    }
  }
}
